{
	email {$ACME_EMAIL}
}

# Sicherheits-Header für alle Seiten
(sicher) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		-Server
	}
	encode zstd gzip
}

# Passwortschutz für Anwendungen ohne öffentliche Freigabe
(intern) {
	basic_auth {
		{$INTERN_USER} {$INTERN_HASH}
	}
	header X-Robots-Tag "noindex, nofollow"
}

# Hauptdomain: neutrale Startseite. Erst aktiv, wenn der A-Eintrag von appzentrale24.de
# auf den Server zeigt (siehe DNS-PLAN.md - E-Mail vorher prüfen).
appzentrale24.de, www.appzentrale24.de {
	import sicher
	root * /srv/site
	file_server
}

import sites/*.caddy
