# Kopieren nach .env (chmod 600) und ausfüllen. Die Datei .env niemals committen.
ACME_EMAIL=admin@appzentrale24.de
# Zugang für alle noch nicht freigegebenen Anwendungen (Passwortabfrage im Browser)
INTERN_USER=pilot
# Erzeugen mit:  docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'IhrPasswort'
# Im .env jedes $ durch $$ ersetzen.
INTERN_HASH=
