# Nach /etc/appzentrale24/backup.env kopieren, chmod 600, Eigentümer root.
#
# Ziel: Hetzner Storage Box (SFTP, Port 23). Der Host-Alias "storagebox" wird in
# /root/.ssh/config eingerichtet (siehe README, Schritt 6). uXXXXXX durch Ihren Benutzer ersetzen.
RESTIC_REPOSITORY=sftp:storagebox:/home/appzentrale24
# Langes Zufallspasswort, erzeugen mit:  openssl rand -base64 32
# ZUSÄTZLICH offline aufbewahren (Passwortmanager / Ausdruck im Tresor).
# Ohne dieses Passwort sind die Sicherungen unwiederbringlich verloren.
RESTIC_PASSWORD=
