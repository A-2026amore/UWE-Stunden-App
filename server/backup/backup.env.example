# Nach /etc/appzentrale24/backup.env kopieren, chmod 600, Eigentümer root.
#
# Ziel: externer Speicher, NICHT derselbe Server. Beispiel netcup Storage Space oder
# eine Storage Box per SFTP:
RESTIC_REPOSITORY=sftp:benutzer@speicher.example.de:/appzentrale24
# Langes Zufallspasswort, z. B.:  openssl rand -base64 32
# ZUSÄTZLICH offline aufbewahren (Passwortmanager / Ausdruck im Tresor).
# Ohne dieses Passwort sind die Sicherungen unwiederbringlich verloren.
RESTIC_PASSWORD=
