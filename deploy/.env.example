# Vorlage für deploy/.env – NUR PLATZHALTER. Echte Werte nur auf dem Server (Rechte 600),
# niemals ins Repository. Kopieren: cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# Passwörter bitte nur aus Buchstaben/Ziffern erzeugen (sie stehen in Verbindungs-URLs):
#   openssl rand -hex 32

# Umgebung: "test" (stunden-test.appzentrale24.de) oder "prod" (später stunden.appzentrale24.de).
# Ergibt die Namen stunden-<STAGE>-app, stunden-<STAGE>-db, Netz stunden-<STAGE>-db, Volume stunden-<STAGE>-db-data.
STAGE=test
APP_HOSTNAME=stunden-test.appzentrale24.de

# Image (lokal gebaut: stunden-app:local).
APP_IMAGE=stunden-app
APP_IMAGE_TAG=local

# Feste Adresse des Reverse Proxys (Caddy) im externen Netz "proxy" (Subnetz 172.30.0.0/24).
# Nur von dieser Adresse wird X-Forwarded-For ausgewertet – nicht vom ganzen Netz.
TRUSTED_PROXY_IP=172.30.0.2

# PostgreSQL-Administrator = Eigentümer von Datenbank und Migrationen (auch für das zentrale Backup).
POSTGRES_USER=stunden_admin
POSTGRES_PASSWORD=BITTE_ERSETZEN_openssl_rand_hex_32
POSTGRES_DB=stunden

# Passwort der Laufzeitrolle app_api (ohne BYPASSRLS); setzt der Job "migrate".
APP_DB_PASSWORD=BITTE_ERSETZEN_openssl_rand_hex_32

# 32-Byte-Schlüssel für die Zwei-Faktor-Geheimnisse: openssl rand -base64 32
# Getrennt von den Datenbank-Backups sichern (docs/betrieb.md 6.1).
TOTP_ENCRYPTION_KEY=BITTE_ERSETZEN
TOTP_ENCRYPTION_KEY_PREVIOUS=
TOTP_ISSUER=Schichtklar24

# E-Mail (Einladungen, Passwort vergessen). Leer = kein Versand (in Produktion nur Warnung im Log).
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.invalid
